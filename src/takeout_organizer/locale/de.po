msgstr "Nicht genug Platz auf {drive} für die geordneten Fotos: benötigt etwa {need}, frei sind {free}."

#: preflight.py
#, python-brace-format
msgid "This drive is FAT32 and cannot hold files over 4 GB. {count} of the files is larger and will fail to copy. Use a drive formatted as exFAT or NTFS."
msgid_plural "This drive is FAT32 and cannot hold files over 4 GB. {count} of the files are larger and will fail to copy. Use a drive formatted as exFAT or NTFS."
msgstr[0] "Dieses Laufwerk ist FAT32 und kann keine Dateien über 4 GB aufnehmen. {count} der Dateien ist größer und wird nicht kopiert. Verwenden Sie ein Laufwerk mit exFAT oder NTFS."
msgstr[1] "Dieses Laufwerk ist FAT32 und kann keine Dateien über 4 GB aufnehmen. {count} der Dateien sind größer und werden nicht kopiert. Verwenden Sie ein Laufwerk mit exFAT oder NTFS."

#: dates.py
#, python-brace-format
msgid "Time zone offset out of range: {zone}"
msgstr "Zeitverschiebung außerhalb des Bereichs: {zone}"

#: dates.py
#, python-brace-format
msgid "Unknown time zone: {zone}. Use an offset such as +09:00, or a name such as Asia/Tokyo (names need: pip install tzdata on Windows)."
msgstr "Unbekannte Zeitzone: {zone}. Verwenden Sie eine Verschiebung wie +09:00 oder einen Namen wie Asia/Tokyo (Namen benötigen unter Windows: pip install tzdata)."

#: naming.py
#, python-brace-format
msgid "The name template {template} is not valid ({reason})."
msgstr "Die Namensvorlage {template} ist ungültig ({reason})."

#: naming.py
#, python-brace-format
msgid "The name template uses {fields}; it can use {{date}}, {{date:FORMAT}} and {{name}}."
msgstr "Die Namensvorlage verwendet {fields}; erlaubt sind {{date}}, {{date:FORMAT}} und {{name}}."

#: naming.py
#, python-brace-format
msgid "The name template must use {{date}} or {{name}}, or every photo would get the same name."
msgstr "Die Namensvorlage muss {{date}} oder {{name}} enthalten, sonst bekäme jedes Foto denselben Namen."

#: undo.py
#, python-brace-format
msgid "No runs are recorded in {folder}."
msgstr "In {folder} sind keine Läufe verzeichnet."

#: undo.py
#, python-brace-format
msgid "Run {run} was not found, or was already undone."
msgstr "Lauf {run} wurde nicht gefunden oder bereits rückgängig gemacht."

#: undo.py
msgid "No run with files to undo was found."
msgstr "Es wurde kein Lauf mit Dateien zum Rückgängigmachen gefunden."

#: metadata_handler.py
msgid "ExifTool not found. Install it (Windows: winget install OliverBetz.ExifTool, macOS: brew install exiftool, Debian/Ubuntu: sudo apt install libimage-exiftool-perl) or pass --exiftool PATH."
msgstr "ExifTool nicht gefunden. Installieren Sie es (Windows: winget install OliverBetz.ExifTool, macOS: brew install exiftool, Debian/Ubuntu: sudo apt install libimage-exiftool-perl) oder geben Sie --exiftool PFAD an."
