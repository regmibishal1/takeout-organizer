#: preflight.py
#, python-brace-format
msgid "{zip} is damaged (it may not have finished downloading). Download it again; your other files are fine."
msgstr "{zip} ist beschädigt (der Download wurde vielleicht nicht beendet). Laden Sie die Datei erneut herunter; Ihre anderen Dateien sind in Ordnung."

#: preflight.py
#, python-brace-format
msgid "{zip} holds {count} files, more than a Takeout part ever does. It is probably damaged or not from Google Takeout. Move it out of the folder and run again."
msgstr "{zip} enthält {count} Dateien, mehr als ein Takeout-Teil je enthält. Die Datei ist vermutlich beschädigt oder stammt nicht aus Google Takeout. Verschieben Sie sie aus dem Ordner und starten Sie erneut."

#: preflight.py
#, python-brace-format
msgid "{zip} would expand from {packed} to {expanded}, more than {times} times its size; Takeout parts barely compress. It is probably damaged or not from Google Takeout. Move it out of the folder and run again."
msgstr "{zip} würde sich von {packed} auf {expanded} vergrößern, mehr als das {times}-Fache; Takeout-Teile sind kaum komprimiert. Die Datei ist vermutlich beschädigt oder stammt nicht aus Google Takeout. Verschieben Sie sie aus dem Ordner und starten Sie erneut."

#: preflight.py
#, python-brace-format
msgid "Part {part} of {last} is missing. Download it into the same folder, or the photos in it will not be organized."
msgstr "Teil {part} von {last} fehlt. Laden Sie ihn in denselben Ordner herunter, sonst werden die Fotos darin nicht geordnet."

#: preflight.py
#, python-brace-format
msgid "Not enough space on {drive}: the run needs about {need}, {free} is free. Free some space, or use --work-dir on another drive. (It may fit if most files are already there.)"
msgstr "Nicht genug Platz auf {drive}: Der Lauf braucht etwa {need}, frei sind {free}. Schaffen Sie Platz, oder verwenden Sie --work-dir auf einem anderen Laufwerk. (Es kann reichen, wenn die meisten Dateien schon dort sind.)"

