#: preflight.py
#, python-brace-format
msgid "{zip} is damaged (it may not have finished downloading). Download it again; your other files are fine."
msgstr "{zip} está dañado (puede que la descarga no terminara). Descárguelo de nuevo; sus demás archivos están bien."

#: preflight.py
#, python-brace-format
msgid "{zip} holds {count} files, more than a Takeout part ever does. It is probably damaged or not from Google Takeout. Move it out of the folder and run again."
msgstr "{zip} contiene {count} archivos, más de los que tiene nunca una parte de Takeout. Probablemente está dañado o no viene de Google Takeout. Sáquelo de la carpeta y vuelva a ejecutar."

#: preflight.py
#, python-brace-format
msgid "{zip} would expand from {packed} to {expanded}, more than {times} times its size; Takeout parts barely compress. It is probably damaged or not from Google Takeout. Move it out of the folder and run again."
msgstr "{zip} pasaría de {packed} a {expanded}, más de {times} veces su tamaño; las partes de Takeout apenas se comprimen. Probablemente está dañado o no viene de Google Takeout. Sáquelo de la carpeta y vuelva a ejecutar."

#: preflight.py
#, python-brace-format
msgid "Part {part} of {last} is missing. Download it into the same folder, or the photos in it will not be organized."
msgstr "Falta la parte {part} de {last}. Descárguela en la misma carpeta, o sus fotos no se organizarán."

#: preflight.py
#, python-brace-format
msgid "Not enough space on {drive}: the run needs about {need}, {free} is free. Free some space, or use --work-dir on another drive. (It may fit if most files are already there.)"
msgstr "No hay espacio suficiente en {drive}: la ejecución necesita unos {need} y hay {free} libres. Libere espacio, o use --work-dir en otra unidad. (Puede bastar si la mayoría de los archivos ya están allí.)"

