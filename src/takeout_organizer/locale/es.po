#: preflight.py
#, python-brace-format
msgid "This drive is FAT32 and cannot hold files over 4 GB. {count} of the files is larger and will fail to copy. Use a drive formatted as exFAT or NTFS."
msgid_plural "This drive is FAT32 and cannot hold files over 4 GB. {count} of the files are larger and will fail to copy. Use a drive formatted as exFAT or NTFS."
msgstr[0] "Esta unidad es FAT32 y no admite archivos de más de 4 GB. {count} de los archivos es más grande y no se podrá copiar. Use una unidad formateada en exFAT o NTFS."
msgstr[1] "Esta unidad es FAT32 y no admite archivos de más de 4 GB. {count} de los archivos son más grandes y no se podrán copiar. Use una unidad formateada en exFAT o NTFS."

