#, python-brace-format
msgid "Unknown time zone: {zone}. Use an offset such as +09:00, or a name such as Asia/Tokyo (names need: pip install tzdata on Windows)."
msgstr "Zona horaria desconocida: {zone}. Use un desfase como +09:00, o un nombre como Asia/Tokyo (en Windows los nombres necesitan: pip install tzdata)."

#: naming.py
#, python-brace-format
msgid "The name template {template} is not valid ({reason})."
msgstr "La plantilla de nombre {template} no es válida ({reason})."

#: naming.py
#, python-brace-format
msgid "The name template uses {fields}; it can use {{date}}, {{date:FORMAT}} and {{name}}."
msgstr "La plantilla de nombre usa {fields}; puede usar {{date}}, {{date:FORMAT}} y {{name}}."

#: naming.py
#, python-brace-format
msgid "The name template must use {{date}} or {{name}}, or every photo would get the same name."
msgstr "La plantilla de nombre debe usar {{date}} o {{name}}, o todas las fotos tendrían el mismo nombre."

#: undo.py
#, python-brace-format
msgid "No runs are recorded in {folder}."
msgstr "No hay ejecuciones registradas en {folder}."

#: undo.py
#, python-brace-format
msgid "Run {run} was not found, or was already undone."
msgstr "No se encontró la ejecución {run}, o ya se deshizo."

#: undo.py
msgid "No run with files to undo was found."
msgstr "No se encontró ninguna ejecución con archivos que deshacer."

#: metadata_handler.py
msgid "ExifTool not found. Install it (Windows: winget install OliverBetz.ExifTool, macOS: brew install exiftool, Debian/Ubuntu: sudo apt install libimage-exiftool-perl) or pass --exiftool PATH."
msgstr "No se encontró ExifTool. Instálelo (Windows: winget install OliverBetz.ExifTool, macOS: brew install exiftool, Debian/Ubuntu: sudo apt install libimage-exiftool-perl) o indique --exiftool RUTA."
